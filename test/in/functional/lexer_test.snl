program lexerDemo

{ This comment should be skipped by the lexer.
  It also checks that line numbers keep advancing. }

type
  Index = integer;
  Letters = array [1..10] of char;
  Pair = record
    integer left, right;
    array [1..3] of char name;
  end;

var
  integer count, total;
  char mark;
  Letters letters;
  Pair pair;

procedure update(var integer value; char flag);
var
  integer i;
begin
  i := 1;
  while i < 10 do
    value := value + i;
    i := i + 1
  endwh;
  return(value)
end

begin
  read(count);
  total := count * 2 / 1;
  mark := 'A';
  letters[1] := mark;
  pair.left := total;
  if count = 0 then
    write(total)
  else
    update(total, mark)
  fi
end.
