program complexCalls

type
  IntArray = array [1..4] of integer;
  Report = record
    integer fibValue, factValue, totalValue, scaledValue;
  end;

var
  integer n, fibResult, factResult, total, scaled;
  IntArray values;
  Report report;

procedure add(integer a; integer b; var integer out);
begin
  out := a + b;
  return(out)
end

procedure scale(integer value; integer factor; var integer out);
begin
  out := value * factor;
  return(out)
end

procedure factorial(integer n; var integer out);
var
  integer sub;
begin
  if n < 2 then
    out := 1
  else
    factorial(n - 1, sub);
    out := n * sub
  fi;
  return(out)
end

procedure fib(integer n; var integer out);
var
  integer left, right;
begin
  if n < 2 then
    out := n
  else
    fib(n - 1, left);
    fib(n - 2, right);
    add(left, right, out)
  fi;
  return(out)
end

procedure storeReport(integer fibIn; integer factIn; integer totalIn; integer scaledIn; var Report dst);
begin
  dst.fibValue := fibIn;
  dst.factValue := factIn;
  dst.totalValue := totalIn;
  dst.scaledValue := scaledIn;
  return(totalIn)
end

procedure printReport(var Report src);
begin
  write(src.fibValue);
  write(src.factValue);
  write(src.totalValue);
  write(src.scaledValue);
  return(src.scaledValue)
end

begin
  n := 6;
  fib(n, fibResult);
  factorial(5, factResult);
  add(fibResult, factResult, total);
  scale(total, 2, scaled);
  values[1] := fibResult;
  values[2] := factResult;
  values[3] := total;
  values[4] := scaled;
  storeReport(values[1], values[2], values[3], values[4], report);
  printReport(report)
end.
