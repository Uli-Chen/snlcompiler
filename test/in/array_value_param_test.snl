program arrayValueParam

type
  IntArray = array [1..4] of integer;

var
  IntArray values;

procedure mutate(IntArray arr);
begin
  arr[1] := arr[1] + 100;
  arr[4] := arr[1] + arr[2];
  write(arr[1]);
  write(arr[4]);
  return(arr[1])
end

begin
  values[1] := 11;
  values[2] := 5;
  values[4] := 1;
  mutate(values);
  write(values[1]);
  write(values[4])
end.
