program arrayStrideBenchmark

type
  IntArray = array [1..1000] of integer;

var
  integer limit, i, idx, sum;
  IntArray values;

begin
  read(limit);
  i := 0;
  idx := 1;
  sum := 0;
  values[1] := 1;
  values[2] := 2;
  values[3] := 3;
  while i < limit do
    values[idx] := values[1] + values[2] + values[3];
    sum := sum + values[idx];
    i := i + 1
  endwh;
  write(sum)
end.
