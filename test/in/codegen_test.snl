program codegenDemo

type
  IntArray = array [1..3] of integer;
  Pair = record
    integer left;
    integer right;
  end;

var
  integer x;
  IntArray nums;
  Pair pair;

procedure addTo(var integer target; integer delta);
begin
  target := target + delta;
  return(target)
end

begin
  x := 2;
  nums[1] := 3;
  pair.left := x + nums[1];
  addTo(pair.left, 4);
  write(pair.left);
  if pair.left < 10 then
    write(1)
  else
    write(0)
  fi
end.
